# ====== النظام ======
# منفذ الخادم (الافتراضي 3001)
PORT=3001

# ====== حساب المدير الافتراضي (يُنشأ تلقائياً عند أول تشغيل) ======
ADMIN_EMAIL=admin@ndr.org
ADMIN_PASSWORD=Admin@5523

# ====== الأمان (غيّر هذه القيمة قبل النشر) ======
# سر توقيع الجلسات - استخدم قيمة عشوائية طويلة
JWT_SECRET=change-this-to-a-long-random-secret
# مدة صلاحية الجلسة
JWT_EXPIRES=7d

# ====== قاعدة البيانات ======
# بدون إعداد: يستخدم النظام SQLite تلقائياً (data/emergency.db) - مناسب للتجربة المحلية
# للاستضافة: ضع رابط PostgreSQL هنا وسيتحول النظام تلقائياً (مثال: خدمة Neon المجانية)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# عند الحاجة لفرض تشفير SSL (Neon/Railway/Supabase غالباً): اتركه افتراضياً أو اجعله true
# PGSSL=true
